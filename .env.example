# =============================================================================
# Lakebranch — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and adjust values as needed.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Storage Profile
# -----------------------------------------------------------------------------
# Selects the object storage backend. Valid values:
#   seaweedfs  - SeaweedFS (default, Apache 2.0, local dev via docker-compose.yml)
#   minio      - MinIO (AGPLv3, local dev via docker-compose.minio.yml)
#   aws-s3     - AWS S3 (production / BYOC via docker-compose.prod-s3.yml)
#   gcs        - Google Cloud Storage
#   adls       - Azure Data Lake Storage Gen2
#   filesystem - Local filesystem (embedded / testing)
STORAGE_PROFILE=seaweedfs

# -----------------------------------------------------------------------------
# Catalog Profile
# -----------------------------------------------------------------------------
# Selects the Iceberg catalog backend. Valid values:
#   nessie   - Nessie REST catalog (default; requires the Docker stack or a
#              remote Nessie server)
#   sqlite   - PyIceberg SQLite catalog (Docker-free; a single local .db file).
#              Pair with STORAGE_PROFILE=filesystem for a fully container-free
#              stack:  STORAGE_PROFILE=filesystem CATALOG_PROFILE=sqlite
#   postgres - PyIceberg SQL catalog backed by a PostgreSQL database
#              (CATALOG_URI, e.g. postgresql://user:pass@host:5432/iceberg).
#              Server-backed like Nessie but without branch/tag versioning.
CATALOG_PROFILE=nessie

# -----------------------------------------------------------------------------
# Object Store Root Credentials
# -----------------------------------------------------------------------------
# Used by the object store directly (SeaweedFS S3 config / MinIO) and by
# Nessie via JDK_JAVA_OPTIONS (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Nessie / PyIceberg REST Catalog (profile: nessie)
# -----------------------------------------------------------------------------
NESSIE_URI=http://localhost:19120/iceberg/main
WAREHOUSE=warehouse

# -----------------------------------------------------------------------------
# SQLite Catalog (profile: sqlite)
# -----------------------------------------------------------------------------
# SQLAlchemy URI for the SQLite catalog database. The parent directory is
# git-ignored (`.lakebranch/`), so the default keeps everything local.
# CATALOG_URI=sqlite:///.lakebranch/catalog.db
# WAREHOUSE=data/warehouse

# -----------------------------------------------------------------------------
# PostgreSQL Catalog (profile: postgres)
# -----------------------------------------------------------------------------
# SQLAlchemy URI for a PostgreSQL database. Works with every storage profile;
# pair with filesystem for a container-free SQL catalog, or with gcs/adls/aws-s3
# for a fully cloud stack. Set WAREHOUSE to the storage URI (e.g. gs://warehouse,
# abfss://warehouse@account.dfs.core.windows.net, s3://warehouse, or a local
# path when using filesystem).
# CATALOG_URI=postgresql://user:pass@localhost:5432/iceberg

# -----------------------------------------------------------------------------
# S3 / Object Store Connection (profile: seaweedfs, minio, aws-s3)
# -----------------------------------------------------------------------------
# For aws-s3, S3_ENDPOINT is optional (AWS S3 is the default endpoint).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=warehouse

# -----------------------------------------------------------------------------
# GCS (Google Cloud Storage) — profile=gcs
# -----------------------------------------------------------------------------
# Uses gcsfs / Application Default Credentials (gcloud auth application-default
# login). WAREHOUSE should be a gs:// URI, e.g. gs://warehouse.
# GCS_BUCKET=warehouse
# GCS_PROJECT=my-project

# -----------------------------------------------------------------------------
# ADLS (Azure Data Lake Storage Gen2) — profile=adls
# -----------------------------------------------------------------------------
# Uses adlfs / the Azure credential chain (az login or environment vars).
# ADLS_ACCOUNT_KEY is optional (account-key auth); omit for managed identity
# or DefaultAzureCredential. WAREHOUSE should be an abfss:// URI, e.g.
# abfss://warehouse@myaccount.dfs.core.windows.net.
# ADLS_ACCOUNT=myaccount
# ADLS_CONTAINER=warehouse
# ADLS_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# Filesystem — profile=filesystem
# -----------------------------------------------------------------------------
# FS_PATH=./data/warehouse